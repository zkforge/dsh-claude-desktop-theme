{
  "name": "dsh-claude-desktop-theme",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Claude Code Desktop-style theme for DeepSeek Harness (DSH) Desktop on macOS and Windows, with light/dark themes, model/effort pickers and an interactive pixel whale",
  "author": "zkforge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkforge/dsh-claude-desktop-theme.git"
  },
  "homepage": "https://github.com/zkforge/dsh-claude-desktop-theme#readme",
  "bugs": {
    "url": "https://github.com/zkforge/dsh-claude-desktop-theme/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-desktop",
    "deepseek",
    "deepseek-harness",
    "claude",
    "claude-code",
    "claude-desktop",
    "claude-code-desktop",
    "dsh-theme",
    "desktop-theme",
    "ui-theme",
    "theme",
    "skin",
    "dark-mode",
    "light-theme",
    "macos",
    "windows",
    "cordis-plugin",
    "ccd"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dsh": {
    "engines": {
      "dsh": "=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm test && npm run build && npm run check:package",
    "prepack": "npm run check",
    "pack:local": "npm pack --pack-destination artifacts",
    "pet:gifs": "node scripts/pet-gifs.mjs",
    "effort:gifs": "node scripts/effort-gif.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@types/node": "26.6.3",
    "@types/react": "18.3.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
